# Angular 20 — build estático + nginx com proxy same-origin para o BFF
# ---- Stage 1: build ----
FROM node:22-alpine AS build
WORKDIR /build

COPY portabilidade-ui/package.json portabilidade-ui/package-lock.json ./
RUN npm ci

COPY portabilidade-ui/ ./
RUN npm run build -- --configuration production

# ---- Stage 2: runtime ----
FROM nginx:1.27-alpine
COPY portabilidade-ui/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/dist/portabilidade-ui/browser /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
